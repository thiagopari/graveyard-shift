{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "types": ["node"],
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": ["skeleton", "mussel-memory", "bridge-troll", "scripts/**/*.ts", "vitest.config.ts", "vite.config.ts"],
  "exclude": ["**/templates/**", "node_modules", "**/dist"]
}
